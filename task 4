import math


def analyze_triangle(a, b, c):
    if a <= 0 or b <= 0 or c <= 0:
        return "Не є трикутником", 0.0

    if a + b <= c or a + c <= b or b + c <= a:
        return "Не є трикутником", 0.0

    if a == b == c:
        triangle_type = "Рівносторонній"
    elif a == b or a == c or b == c:
        triangle_type = "Рівнобедрений"
    else:
        triangle_type = "Різносторонній"

    sides = sorted([a, b, c])

    if math.isclose(
        sides[0] ** 2 + sides[1] ** 2,
        sides[2] ** 2
    ):
        triangle_type += ", прямокутний"

    p = (a + b + c) / 2
    area = math.sqrt(p * (p - a) * (p - b) * (p - c))

    return triangle_type, area


def main():
    try:
        a = float(input("Введіть сторону a: "))
        b = float(input("Введіть сторону b: "))
        c = float(input("Введіть сторону c: "))

        triangle_type, area = analyze_triangle(a, b, c)

        print(f"Тип трикутника: {triangle_type}")
        print(f"Площа трикутника: {area:.2f}")

    except ValueError:
        print("Помилка: введіть числові значення.")


if __name__ == "__main__":
    main()
