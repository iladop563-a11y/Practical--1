import math

def main():
    try:
        a = float(input("Введіть a: "))
        b = float(input("Введіть b: "))
        c = float(input("Введіть c: "))
    except ValueError:
        print("Помилка: введіть числові значення.")
        return

    sum_squares = a**2 + b**2 + c**2
    average = (a + b + c) / 3
    discriminant = b**2 - 4 * a * c
    hypotenuse = math.sqrt(a**2 + b**2) if a > 0 and b > 0 else 0.0

    is_triangle = (
        a + b > c and
        a + c > b and
        b + c > a and
        a > 0 and b > 0 and c > 0
    )

    print("\n--- Результати обчислень ---")
    print(f"Сума квадратів: {sum_squares:.2f}")
    print(f"Середнє арифметичне: {average:.2f}")
    print(f"Дискримінант: {discriminant:.2f}")
    print(f"Гіпотенуза: {hypotenuse:.2f}")
    print(f"Чи утворюють сторони трикутник: {'Так' if is_triangle else 'Ні'}")

if __name__ == "__main__":
    main()
