def calculate_factorial(n):
    result = 1

    for i in range(1, n + 1):
        result *= i

    return result


def harmonic_sum(n):
    total = 0.0

    for i in range(1, n + 1):
        total += 1 / i

    return total


def multiplication_table(n):
    print(f"\nТаблиця множення для {n}:")

    for i in range(1, 11):
        print(f"{n} x {i} = {n * i}")


def main():
    try:
        n = int(input("Введіть ціле невід'ємне число: "))

        if n < 0:
            print("Помилка: число не може бути від'ємним.")
            return

        factorial = calculate_factorial(n)
        harmonic = harmonic_sum(n)

        print(f"\nФакторіал числа {n}: {factorial}")
        print(f"Гармонічна сума: {harmonic:.4f}")

        multiplication_table(n)

    except ValueError:
        print("Помилка: введіть ціле число.")


if __name__ == "__main__":
    main()
