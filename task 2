def main():
    raw_input_str = input("Введіть число: ")

    try:
        val_int = int(raw_input_str)
        val_float = float(raw_input_str)
        val_bool = bool(val_int)
    except ValueError:
        try:
            val_float = float(raw_input_str)
            val_int = int(val_float)
            val_bool = bool(val_float)
        except ValueError:
            print("Неможливо конвертувати у числові типи.")
            return

    print(f"\nЗначення: {raw_input_str}")
    print(f"int: {val_int}, тип: {type(val_int)}")
    print(f"float: {val_float}, тип: {type(val_float)}")
    print(f"bool: {val_bool}, тип: {type(val_bool)}")

    name = input("\nВведіть ваше ім'я: ").strip()
    age = int(input("Введіть ваш вік: "))

    print(f"Привіт, {name.capitalize():>10}! Твій вік — {age:03d} років.")

    my_list = list(range(1, 6))

    print(f"\nЗгенерований список: {my_list}")
    print(f"Довжина списку (len): {len(my_list)}")
    print(f"Унікальний ідентифікатор (id): {id(my_list)}")
    print(f"Рядкове представлення (str): {str(my_list)}")


if __name__ == "__main__":
    main()
